            <p>Thể loại: </p>
            <a href="@Url.Action("Index", "DatVe")" class="booking-btn">Đặt vé ngay</a>
        </div>

        <div class="movie-card">
            <img src="~/Imgs/mai.jpg" alt="Mai">
