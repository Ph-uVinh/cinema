@{
    ViewBag.Title = "Đăng nhập";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Đăng nhập</title>
    <link href="@Url.Content("~/Content/Mystyle/style1.css")" rel="stylesheet" />
</head>
<body>
    <div class="form-page">
        <div class="form-box">
            <h2>ĐĂNG NHẬP</h2>
            <p>Chào mừng bạn đến với CinemaTicket</p>

            <form>
                <input type="text" placeholder="Tên đăng nhập" required />
                <input type="password" placeholder="Mật khẩu" required />

                <button type="submit">Đăng nhập</button>
            </form>

            <p class="form-link">
                Chưa có tài khoản?
                <a href="@Url.Action("Index", "DangKy")">Đăng ký</a>
            </p>
        </div>
    </div>
</body>
</html>
