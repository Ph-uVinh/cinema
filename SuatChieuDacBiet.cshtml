@{
    ViewBag.Title = "Suất Chiếu Đặc Biệt";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="movie-container">
    <h2 class="page-title">SUẤT CHIẾU ĐẶC BIỆT</h2>

    <div class="movie-list">

        <div class="movie-card">
            <img src="~/Imgs/muado.jpg" alt="Mưa Đỏ">
            <span class="special-label">SUẤT CHIẾU ĐẶC BIỆT</span>
            <h3>Mưa Đỏ</h3>
            <p>Định dạng: 2D</p>
            <p>Thời gian: Đang cập nhật</p>
            <a href="@Url.Action("Index", "DatVe")" class="booking-btn">Xem thông tin</a>
        </div>

        <div class="movie-card">
            <img src="~/Imgs/latmat8.jpg" alt="Lật Mặt 8">
            <span class="special-label">SUẤT CHIẾU ĐẶC BIỆT</span>
            <h3>Lật Mặt 8</h3>
            <p>Định dạng: 2D</p>
            <p>Thời gian: Đang cập nhật</p>
            <a href="@Url.Action("Index", "DatVe")" class="booking-btn">Xem thông tin</a>
        </div>

        <div class="movie-card">
            <img src="~/Imgs/botubaothu.jpg" alt="Bộ Tứ Báo Thủ">
            <span class="special-label">SUẤT CHIẾU ĐẶC BIỆT</span>
            <h3>Bộ Tứ Báo Thủ</h3>
            <p>Định dạng: 2D</p>
            <p>Thời gian: Đang cập nhật</p>
            <a href="@Url.Action("Index", "DatVe")" class="booking-btn">Xem thông tin</a>
        </div>

        <div class="movie-card">
            <img src="~/Imgs/imax_us_original_size.jpg" alt="Godzilla">
            <span class="special-label">SUẤT CHIẾU ĐẶC BIỆT</span>
            <h3>Godzilla</h3>
            <p>Định dạng: IMAX</p>
            <p>Thời gian: Đang cập nhật</p>
            <a href="@Url.Action("Index", "DatVe")" class="booking-btn">Xem thông tin</a>
        </div>

    </div>
</div>